diff --git a/bsd/kern/kern_sysctl.c b/bsd/kern/kern_sysctl.c
--- a/bsd/kern/kern_sysctl.c
+++ b/bsd/kern/kern_sysctl.c
@@ -2852,6 +2852,18 @@
 		}
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SWEET boots an HFS+ root: there is no APFS preboot volume for
+	 * IOGetApfsPrebootUUID to report.  iOS 16's libignition asks for this
+	 * before it mounts the cryptexes and aborts ignition ("failed to lookup
+	 * preboot: 25") when it is missing, so hand it a stable, valid UUID.
+	 */
+	if (error) {
+		strlcpy(uuid_string, "00000000-0000-0000-0000-000000000001", sizeof uuid_string);
+		error = sysctl_io_string(req, uuid_string, 0, 0, NULL);
+	}
+#endif
 	return error;
 }
 
