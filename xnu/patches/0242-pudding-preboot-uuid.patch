diff --git a/bsd/kern/kern_sysctl.c b/bsd/kern/kern_sysctl.c
--- a/bsd/kern/kern_sysctl.c
+++ b/bsd/kern/kern_sysctl.c
@@ -2852,6 +2852,18 @@
 		}
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SWEET boots an HFS+ root: no APFS preboot volume exists, so
+	 * IOGetApfsPrebootUUID reports nothing and iOS 16's libignition aborts
+	 * ignition ("failed to lookup preboot").  Hand it a valid UUID.
+	 */
+	if (error) {
+		static const char sweet_preboot[] = "00000000-0000-0000-0000-000000000001";
+		memcpy(uuid_string, sweet_preboot, sizeof sweet_preboot);
+		error = sysctl_io_string(req, uuid_string, 0, 0, NULL);
+	}
+#endif
 	return error;
 }
 
