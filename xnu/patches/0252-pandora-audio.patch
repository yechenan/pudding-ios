 		pa_sleep(100);
-		err = err ? err : pa_reg(addr, r_beat, &beat1);
-		err = err ? err : pa_reg(addr, PA_HALO_CORE, &core);
-		err = err ? err : pa_reg(addr, PA_MPU_LOCK, &lock);
-		err = err || !r_state ? err : pa_reg(addr, r_state, &state);
