+static void
+pa_num(OSDictionary *d, const char *key, uint64_t value, unsigned bits)
+{
+	OSNumber *n = OSNumber::withNumber(value, bits);
+	if (n != nullptr) {
+		d->setObject(key, n);
+		n->release();
+	}
+}
