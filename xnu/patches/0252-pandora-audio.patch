+static void
+pa_halo(uint8_t addr, const char *when)
+{
+	static const uint32_t regs[] = {0x2b80000, 0x2b80010, 0x2b805c0, 0x2b805c8, 0x2b805d0, 0x2b805d8, 0x2bc1000,
