+	if (pa_tlmm) {
+		const uint32_t rcv_ctl = pa_rd(pa_tlmm, PA_GPIO(174)), rcv_io = pa_rd(pa_tlmm, PA_GPIO(174) + 4);
+		pa_gpio(174, 0, 3, 2, 1);
+		printf("PANDORA AMP: GPIO 174 (top amp receiver switch) was %#x/%u, now %#x/%u (Android: output high)\n",
+		    rcv_ctl, rcv_io & 3u, pa_rd(pa_tlmm, PA_GPIO(174)), pa_rd(pa_tlmm, PA_GPIO(174) + 4) & 3u);
+	}
+	if (!pa_ready) {
+		printf("PANDORA AMP: TDM clock up, but the amps are not loaded and started\n");
+		(void)thread_terminate(current_thread());
+		thread_block(THREAD_CONTINUE_NULL);
