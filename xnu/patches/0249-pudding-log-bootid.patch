diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1831,8 +1831,17 @@
  * Returns the byte count; *pos advances.
  */
 uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
 
+/* 0249: upstream's 0258 gives the final drain a copy that goes up to every byte
+ * taken, not only the ones a writer finished storing.  Our sweet_log_copy
+ * already reads sweet_log_total, so it is the same read under either name. */
+uint32_t
+sweet_log_copy_any(uint64_t *pos, char *out, uint32_t max)
+{
+	return sweet_log_copy(pos, out, max);
+}
+
 uint32_t
 sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
 {
 	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
@@ -1858,8 +1867,14 @@
 struct sweet_log_header {
 	char magic[8];
 	uint32_t version, size;
 	uint64_t total, seq;
+	/* 0249: v2 appends these; v1 readers stop after seq. */
+	uint64_t boot_id;          /* epoch seconds at the first log byte */
+	uint64_t completed;        /* last total written and synced */
+	uint32_t restart_type;     /* PEHaltRestart type that ended this boot */
+	uint32_t pad0;
+	uint64_t restart_uptime;   /* uptime in ns when that restart began */
 };
 
