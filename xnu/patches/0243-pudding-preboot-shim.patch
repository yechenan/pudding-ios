diff --git a/bsd/dev/pandora_preboot.c b/bsd/dev/pandora_preboot.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/bsd/dev/pandora_preboot.c
@@ -0,0 +1,237 @@
+/*
+ * PANDORA preboot shim (patch 0243): make iOS 16 libignition's "preboot"
+ * stage succeed on an HFS+ root.
+ *
+ * libignition lives inside /usr/lib/dyld and runs in-process when launchd
+ * starts.  Its __preboot_fire() asks the root filesystem two questions that
+ * only APFS answers:
+ *
+ *   1. fsctl("/", _IOWR('J', 80, 260), &args) with
+ *        struct { u8 op; u8 pad; u16 role; char devnode[256]; }
+ *      op 2 = "devnode for this volume role", role = VFS_PREBOOT_ROLE (16).
+ *      HFS+ has no such fsctl, so the command fell through to VNOP_IOCTL and
+ *      came back ENOTSUP -- the "failed to lookup preboot: 25" in the log.
+ *
+ *   2. sysctl "vfs.generic.apfs.edt_fstab": an array of 236-byte records with
+ *      the mount point string at +0x20 and the u32 volume role at +0xE8.
+ *      libignition scans it for role 16 and takes that path as the mount point.
+ *
+ * Then it opens the mount point and calls fmount("apfs", ...).  The "apfs" vfs
+ * registered here answers EBUSY, which libignition reports as "preboot already
+ * mounted" and carries on with the directory it already has -- exactly what we
+ * want, because in the pudding image /private/preboot is part of the HFS+ root.
+ *
+ * The tree libignition and mount -P expect is created here on the first
+ * lookup, named after /chosen/boot-manifest-hash (the same value bindfs and
+ * launchd build their paths from):
+ *
+ *   /private/preboot/<hash uppercase hex>/
+ *       .roots-installed
+ *       cryptex1
+ *       usr/standalone/firmware
+ *
+ * so the 16 GiB root image does not have to be rebuilt for it.
+ *
+ * The commands, the record layout and the role number were recovered from the
+ * binary: tools/ in the repo, docs/PUDDING_STATUS.md.
+ */
+#if defined(PANDORA)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/mount.h>
+#include <sys/mount_internal.h>
+#include <sys/sysctl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <string.h>
+
+extern int pandora_mkdir(const char *path, int mode);          /* bsd/vfs/vfs_syscalls.c */
+extern int sweet_amfi_publish(void);                           /* iokit/Kernel/arm/SweetAMFI.cpp */
+extern bool IOGetBootManifestHash(char *hash, size_t *size);   /* iokit/bsddev/IOKitBSDInit.cpp */
+
+/* fsctl("/", _IOWR('J', 80, 260)): 260 = 2 + 2 + 256 */
+#define PANDORA_DEVNODE_BY_ROLE_CMD     0xc1044a50ul
+#define PANDORA_DEVNODE_OP_GET          2
+
+struct pandora_devnode_args {
+	uint8_t  da_op;
+	uint8_t  da_pad;
+	uint16_t da_role;
+	char     da_devnode[256];
+};
+
+/* One entry of vfs.generic.apfs.edt_fstab, as libignition reads it. */
+struct pandora_edt_fstab {
+	char     ef_reserved[0x20];
+	char     ef_mount_point[0xc8];
+	uint32_t ef_role;
+} __attribute__((packed));
+
+_Static_assert(sizeof(struct pandora_devnode_args) == 260, "libignition passes a 260-byte buffer");
+_Static_assert(sizeof(struct pandora_edt_fstab) == 0xec, "libignition walks 236-byte records");
+
+static boolean_t pandora_preboot_ready;
+
+/* The devnode and the mount point of a volume role.  Only the preboot volume
+ * exists here: the root is one HFS+ file system, so its own device node is the
+ * honest answer for role 16 and every other role is absent. */
+int
+pandora_preboot_fsctl(u_long cmd, caddr_t data, int size)
+{
+	struct pandora_devnode_args *args = (struct pandora_devnode_args *)data;
+
+	if (cmd != PANDORA_DEVNODE_BY_ROLE_CMD || size < (int)sizeof(*args)) {
+		return EINVAL;
+	}
+	if (args->da_op != PANDORA_DEVNODE_OP_GET) {
+		return EINVAL;
+	}
+	if (args->da_role != VFS_PREBOOT_ROLE) {
+		return ENOENT;
+	}
+	bzero(args->da_devnode, sizeof(args->da_devnode));
+	strlcpy(args->da_devnode, "/dev/ufsroot0", sizeof(args->da_devnode));
+	return 0;
+}
+
+static int
+pandora_apfs_mount(__unused struct mount *mp, __unused vnode_t devvp,
+    __unused user_addr_t data, __unused vfs_context_t context)
+{
+	/* libignition treats EBUSY as "preboot is already mounted" and keeps the
+	 * directory it opened; anything else aborts the ignition. */
+	return EBUSY;
+}
+
+static int
+pandora_apfs_init(__unused struct vfsconf *vfsp)
+{
+	return 0;
+}
+
+/* Registered by name in bsd/vfs/vfs_conf.c so that libignition's
+ * fmount("apfs", ...) resolves the filesystem and reaches our mount op. */
+struct vfsops pandora_apfs_vfsops = {
+	.vfs_mount = pandora_apfs_mount,
+	.vfs_init  = pandora_apfs_init,
+};
+
+/* Create an empty file (or leave an existing one alone). */
+static int
+pandora_touch(const char *path, int mode)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, O_CREAT | FWRITE, mode, 0, &vp, vfs_context_kernel());
+
+	if (error == 0) {
+		vnode_close(vp, FWRITE, vfs_context_kernel());
+	} else if (error == EEXIST) {
+		error = 0;
+	}
+	return error;
+}
+
+/* Every path under /private/preboot the boot sequence looks for.  HFS+ takes
+ * one level at a time, and EEXIST is the normal case after the first boot. */
+static const char * const pandora_preboot_dirs[] = {
+	"usr",
+	"usr/standalone",
+	"usr/standalone/firmware",
+	"cryptex1",
+};
+
+static void
+pandora_preboot_tree(void)
+{
+	uint8_t hash[64];
+	size_t hlen = sizeof(hash);
+	char hex[2 * sizeof(hash) + 1];
+	char path[MAXPATHLEN];
+	static const char digits[] = "0123456789ABCDEF";
+	int error;
+
+	if (pandora_preboot_ready) {
+		return;
+	}
+	pandora_preboot_ready = TRUE;
+
+	/* Publish AppleMobileFileIntegrity early: launchd_cache_loader matches it
+	 * by class name at ~12 s and aborted (then the kernel panicked) without it. */
+	if (sweet_amfi_publish() != 0) {
+		printf("PANDORA PREBOOT: no AMFI service\n");
+	}
+
+	/* keybagd (MKB) opens the system keybag on the data volume and reboots
+	 * when the open fails ("Could not open /private/var/keybags/systembag.kb
+	 * ... FATAL KEYBAG ERROR").  This machine has no data volume, so give it
+	 * an empty file there: MKB then reports an empty keybag instead of dying
+	 * at the open. */
+	(void)pandora_mkdir("/private/var", 0755);
+	(void)pandora_mkdir("/private/var/keybags", 0700);
+	error = pandora_touch("/private/var/keybags/systembag.kb", 0600);
+	printf("PANDORA PREBOOT: /private/var/keybags/systembag.kb: %d\n", error);
+
+	(void)pandora_mkdir("/private/preboot", 0755);
+
+	if (!IOGetBootManifestHash((char *)hash, &hlen) || hlen == 0 || hlen > sizeof(hash)) {
+		printf("PANDORA PREBOOT: no boot-manifest-hash, no preboot tree\n");
+		return;
+	}
+	for (size_t i = 0; i < hlen; i++) {
+		hex[2 * i] = digits[hash[i] >> 4];
+		hex[2 * i + 1] = digits[hash[i] & 0xf];
+	}
+	hex[2 * hlen] = 0;
+
+	snprintf(path, sizeof(path), "/private/preboot/%s", hex);
+	error = pandora_mkdir(path, 0755);
+	if (error != 0 && error != EEXIST) {
+		printf("PANDORA PREBOOT: %s: error %d\n", path, error);
+		return;
+	}
+	for (size_t i = 0; i < sizeof(pandora_preboot_dirs) / sizeof(pandora_preboot_dirs[0]); i++) {
+		snprintf(path, sizeof(path), "/private/preboot/%s/%s", hex, pandora_preboot_dirs[i]);
+		error = pandora_mkdir(path, 0755);
+		if (error != 0 && error != EEXIST) {
+			printf("PANDORA PREBOOT: %s: error %d\n", path, error);
+		}
+	}
+
+	/* libignition's cryptex1 sniff does fstatat(preboot_root, "cryptex1"); with
+	 * ENOENT the stage returns 8 (the log said "cryptex1 sniff: ignition failed:
+	 * 8") and ignition stops there. */
+	(void)pandora_mkdir("/private/preboot/cryptex1", 0755);
+	(void)pandora_mkdir("/private/preboot/cryptex1/current", 0755);
+
+	snprintf(path, sizeof(path), "/private/preboot/%s/.roots-installed", hex);
+	error = pandora_touch(path, 0644);
+	printf("PANDORA PREBOOT: /private/preboot/%s: %d\n", hex, error);
+}
+
+static int
+pandora_apfs_edt_fstab SYSCTL_HANDLER_ARGS
+{
+	struct pandora_edt_fstab entry;
+
+	/* libignition only ever asks for the preboot role, so one record is the
+	 * whole table.  Creating the tree here is what makes the mount point it
+	 * reads below actually exist. */
+	pandora_preboot_tree();
+
+	bzero(&entry, sizeof(entry));
+	strlcpy(entry.ef_mount_point, "/private/preboot", sizeof(entry.ef_mount_point));
+	entry.ef_role = VFS_PREBOOT_ROLE;
+	return sysctl_io_opaque(req, &entry, sizeof(entry), NULL);
+}
+
+SYSCTL_DECL(_vfs_generic);
+SYSCTL_NODE(_vfs_generic, OID_AUTO, apfs, CTLFLAG_RW | CTLFLAG_LOCKED, 0,
+    "APFS-only interfaces, answered by the pudding shim");
+SYSCTL_PROC(_vfs_generic_apfs, OID_AUTO, edt_fstab,
+    CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    pandora_apfs_edt_fstab, "-", "volume role to mount point table");
+
+#endif /* PANDORA */
